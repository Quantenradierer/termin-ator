# Discord bot token (required) -- from the Discord Developer Portal.
DISCORD_TOKEN=

# IANA timezone used for parsing and rendering dinner dates. Default: Europe/Berlin
TZ=Europe/Berlin

# Path to the SQLite database file. In Docker this must live on the mounted volume.
SQLITE_PATH=./data/restaurants.db

# Popularity smoothing factor (0 < lambda <= 1). Default: 0.3
EMA_LAMBDA=0.3

# Minimum weight a restaurant can have after a recalculation. Default: 0.05
WEIGHT_FLOOR=0.05

# Local hour (0-23) on the visit date to ping everyone who voted for the winner. Default: 9
REMINDER_HOUR=9
